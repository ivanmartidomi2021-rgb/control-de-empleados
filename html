<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="description" content="Sistema profesional de control de empleados, jornadas y pagos" />
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💰</text></svg>" />
    <title>IVAN MARÍNEZ — Control Financiero</title>
    <!-- Chart.js para gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js">
    </script>
    <style>
        /* ============================================================
                   CSS COMPLETO — ESTILOS MODERNOS EMPRESARIALES
                   ============================================================ */

        /* ---------- RESET & VARIABLES ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #0a0a0f;
            --bg2: #12121a;
            --bg3: #1a1a2e;
            --bg4: #24243a;
            --bg-card: #151525;
            --text: #e8e8f0;
            --text2: #a0a0b8;
            --text3: #6a6a8a;
            --border: #2a2a40;
            --shadow: rgba(0, 0, 0, 0.6);
            --primary: #4f8cff;
            --primary-dark: #3a6fd9;
            --green: #2ecc71;
            --green-dark: #1a9c54;
            --yellow: #f1c40f;
            --yellow-dark: #d4a800;
            --blue: #3498db;
            --blue-dark: #2176b8;
            --red: #e74c3c;
            --red-dark: #c0392b;
            --radius: 16px;
            --radius-sm: 10px;
            --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --watermark-opacity: 0.06;
        }

        .light-mode {
            --bg: #f0f2f8;
            --bg2: #e4e7ef;
            --bg3: #d5d9e6;
            --bg4: #c5cada;
            --bg-card: #ffffff;
            --text: #1a1a2e;
            --text2: #3a3a5a;
            --text3: #6a6a8a;
            --border: #c5cada;
            --shadow: rgba(0, 0, 0, 0.1);
            --watermark-opacity: 0.08;
        }

        html {
            font-size: 16px;
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            transition: background var(--transition), color var(--transition);
            overflow-x: hidden;
        }

        /* ---------- SCROLLBAR ---------- */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg2);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        /* ---------- WATERMARK ---------- */
        .watermark {
            position: fixed;
            pointer-events: none;
            font-size: 10rem;
            font-weight: 800;
            color: var(--text);
            opacity: var(--watermark-opacity);
            z-index: 0;
            letter-spacing: 4px;
            user-select: none;
            white-space: nowrap;
            transform: rotate(-12deg);
            bottom: -20px;
            right: -40px;
            font-family: 'Georgia', serif;
        }
        .watermark-sm {
            font-size: 1.2rem;
            opacity: 0.25;
            position: relative;
            display: inline-block;
            margin-left: 8px;
            font-weight: 300;
            letter-spacing: 2px;
            color: var(--text3);
        }

        /* ---------- SIDEBAR ---------- */
        .sidebar {
            width: 72px;
            background: var(--bg2);
            border-right: 1px solid var(--border);
            height: 100vh;
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 18px 0;
            gap: 8px;
            flex-shrink: 0;
            z-index: 100;
            transition: width 0.3s, background var(--transition);
            overflow: hidden;
        }
        .sidebar:hover {
            width: 220px;
        }
        .sidebar .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 12px;
            white-space: nowrap;
            margin-bottom: 20px;
            letter-spacing: -0.5px;
        }
        .sidebar .logo span {
            font-size: 0.9rem;
            color: var(--text2);
            font-weight: 400;
            display: none;
        }
        .sidebar:hover .logo span {
            display: inline;
        }
        .sidebar .logo small {
            font-size: 0.55rem;
            opacity: 0.5;
            display: block;
            font-weight: 300;
        }

        .nav-btn {
            background: transparent;
            border: none;
            color: var(--text3);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 1.2rem;
            width: 90%;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all var(--transition);
            white-space: nowrap;
            font-family: var(--font);
        }
        .nav-btn span {
            font-size: 0.85rem;
            font-weight: 500;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .sidebar:hover .nav-btn span {
            opacity: 1;
        }
        .nav-btn:hover,
        .nav-btn.active {
            background: var(--bg3);
            color: var(--text);
        }
        .nav-btn.active {
            color: var(--primary);
            background: rgba(79, 140, 255, 0.12);
        }
        .nav-btn .badge {
            background: var(--red);
            color: #fff;
            font-size: 0.6rem;
            padding: 2px 8px;
            border-radius: 20px;
            margin-left: auto;
        }
        .sidebar-footer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
            width: 100%;
            align-items: center;
        }

        /* ---------- MAIN CONTENT ---------- */
        .main {
            flex: 1;
            padding: 24px 32px 40px;
            overflow-y: auto;
            max-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* ---------- HEADER ---------- */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 28px;
        }
        .topbar h1 {
            font-size: 1.7rem;
            font-weight: 600;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .topbar h1 small {
            font-size: 0.8rem;
            font-weight: 400;
            color: var(--text2);
        }
        .topbar-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        .topbar-actions button,
        .topbar-actions .btn {
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 8px 18px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all var(--transition);
            font-family: var(--font);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .topbar-actions button:hover,
        .topbar-actions .btn:hover {
            background: var(--bg4);
            border-color: var(--primary);
        }
        .topbar-actions .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
        }
        .topbar-actions .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
        }
        .theme-toggle {
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 30px;
            padding: 6px 12px;
            cursor: pointer;
            font-size: 1.2rem;
            transition: all var(--transition);
            color: var(--text);
        }

        /* ---------- CARDS / DASHBOARD ---------- */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 20px;
            box-shadow: 0 4px 20px var(--shadow);
            transition: all var(--transition);
            position: relative;
            overflow: hidden;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px var(--shadow);
        }
        .card .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text3);
            font-weight: 600;
        }
        .card .value {
            font-size: 1.8rem;
            font-weight: 700;
            margin-top: 4px;
            letter-spacing: -0.5px;
        }
        .card .sub {
            font-size: 0.75rem;
            color: var(--text2);
            margin-top: 2px;
        }
        .card .trend {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 6px;
        }
        .trend.up {
            background: rgba(46, 204, 113, 0.2);
            color: var(--green);
        }
        .trend.down {
            background: rgba(231, 76, 60, 0.2);
            color: var(--red);
        }

        /* ---------- TABLA SEMANAL ---------- */
        .week-nav {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }
        .week-nav button {
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 6px 16px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all var(--transition);
            font-family: var(--font);
        }
        .week-nav button:hover {
            background: var(--bg4);
        }
        .week-nav .week-label {
            font-weight: 600;
            font-size: 1.05rem;
            min-width: 200px;
            text-align: center;
        }

        .table-wrap {
            overflow-x: auto;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--bg-card);
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
            min-width: 600px;
        }
        th {
            background: var(--bg2);
            text-align: left;
            padding: 12px 14px;
            font-weight: 600;
            color: var(--text2);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            border-bottom: 2px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 5;
        }
        td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }
        tr:hover td {
            background: var(--bg2);
        }
        .employee-name {
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .employee-name .avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--bg3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text2);
        }
        .day-cell {
            cursor: pointer;
            text-align: center;
            font-weight: 500;
            padding: 6px 8px;
            border-radius: 8px;
            transition: all var(--transition);
            min-width: 40px;
            display: inline-block;
        }
        .day-cell:hover {
            background: var(--bg3);
            transform: scale(1.05);
        }
        .day-cell.complete {
            color: var(--green);
        }
        .day-cell.half {
            color: var(--yellow);
        }
        .day-cell.hours {
            color: var(--blue);
        }
        .day-cell.off {
            color: var(--red);
            opacity: 0.5;
        }
        .total-col {
            font-weight: 700;
            text-align: right;
        }

        /* ---------- MODAL ---------- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(6px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
            padding: 20px;
            animation: fadeIn 0.25s ease;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            max-width: 560px;
            width: 100%;
            padding: 28px 32px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
            animation: slideUp 0.3s ease;
        }
        .modal h2 {
            font-size: 1.3rem;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .modal .close-btn {
            margin-left: auto;
            background: none;
            border: none;
            color: var(--text3);
            font-size: 1.5rem;
            cursor: pointer;
        }
        .modal label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text2);
            margin-top: 14px;
            margin-bottom: 4px;
        }
        .modal input,
        .modal select,
        .modal textarea {
            width: 100%;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg2);
            color: var(--text);
            font-size: 0.95rem;
            font-family: var(--font);
            transition: border var(--transition);
        }
        .modal input:focus,
        .modal select:focus,
        .modal textarea:focus {
            outline: none;
            border-color: var(--primary);
        }
        .modal textarea {
            resize: vertical;
            min-height: 60px;
        }
        .modal .btn-row {
            display: flex;
            gap: 10px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .modal .btn-row button {
            flex: 1;
            min-width: 100px;
            padding: 10px 18px;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition);
            font-family: var(--font);
            font-size: 0.9rem;
        }
        .btn-primary-modal {
            background: var(--primary);
            color: #fff;
        }
        .btn-primary-modal:hover {
            background: var(--primary-dark);
        }
        .btn-secondary-modal {
            background: var(--bg3);
            color: var(--text);
        }
        .btn-secondary-modal:hover {
            background: var(--bg4);
        }
        .btn-danger-modal {
            background: var(--red);
            color: #fff;
        }
        .btn-danger-modal:hover {
            background: var(--red-dark);
        }

        /* ---------- TOAST ---------- */
        .toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 380px;
        }
        .toast {
            background: var(--bg-card);
            border-left: 4px solid var(--primary);
            padding: 14px 20px;
            border-radius: var(--radius-sm);
            box-shadow: 0 8px 30px var(--shadow);
            animation: slideIn 0.35s ease;
            font-size: 0.9rem;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .toast.success {
            border-left-color: var(--green);
        }
        .toast.error {
            border-left-color: var(--red);
        }
        .toast.warning {
            border-left-color: var(--yellow);
        }
        .toast .toast-icon {
            font-size: 1.4rem;
        }

        /* ---------- SECCIONES ---------- */
        .section {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .section.active {
            display: block;
        }

        /* ---------- EMPLEADOS GRID ---------- */
        .employees-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .employee-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 20px;
            transition: all var(--transition);
            cursor: pointer;
            position: relative;
        }
        .employee-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
        }
        .employee-card .name {
            font-weight: 700;
            font-size: 1.1rem;
        }
        .employee-card .role {
            font-size: 0.8rem;
            color: var(--text2);
        }
        .employee-card .status {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 12px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 6px;
        }
        .status.active {
            background: rgba(46, 204, 113, 0.2);
            color: var(--green);
        }
        .status.inactive {
            background: rgba(231, 76, 60, 0.2);
            color: var(--red);
        }
        .employee-card .debt {
            font-size: 0.8rem;
            color: var(--red);
            font-weight: 600;
            margin-top: 4px;
        }

        /* ---------- HISTORIAL ---------- */
        .history-item {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 16px 20px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .history-item .week-label {
            font-weight: 600;
        }
        .history-item .totals {
            display: flex;
            gap: 20px;
            font-size: 0.9rem;
        }
        .history-item .totals span {
            color: var(--text2);
        }
        .history-item .totals strong {
            color: var(--text);
        }

        /* ---------- ESTADÍSTICAS ---------- */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
            margin-top: 20px;
        }
        .chart-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px;
        }
        .chart-box h3 {
            font-size: 0.95rem;
            margin-bottom: 12px;
            color: var(--text2);
        }
        .chart-box canvas {
            max-height: 200px;
            max-width: 100%;
        }

        /* ---------- CONFIGURACIÓN ---------- */
        .config-group {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        .config-group h3 {
            font-size: 1rem;
            margin-bottom: 12px;
            color: var(--text2);
        }
        .config-group .row {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            align-items: center;
        }
        .config-group .row label {
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .config-group .row input[type="text"],
        .config-group .row input[type="number"] {
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg2);
            color: var(--text);
            width: 140px;
        }
        .config-group .row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
        }

        /* ---------- RESPONSIVE ---------- */
        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
                padding: 12px 0;
            }
            .sidebar:hover {
                width: 60px;
            }
            .sidebar .logo span,
            .sidebar .nav-btn span {
                display: none !important;
            }
            .sidebar .logo {
                font-size: 1.2rem;
                padding: 0;
            }
            .main {
                padding: 16px;
            }
            .topbar h1 {
                font-size: 1.2rem;
            }
            .cards-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }
            .card .value {
                font-size: 1.3rem;
            }
            .modal {
                padding: 20px;
                margin: 10px;
            }
            .employees-grid {
                grid-template-columns: 1fr 1fr;
            }
            .charts-grid {
                grid-template-columns: 1fr;
            }
            .history-item {
                flex-direction: column;
                align-items: flex-start;
            }
            .week-nav .week-label {
                font-size: 0.85rem;
                min-width: auto;
            }
            .table-wrap {
                font-size: 0.8rem;
            }
            td,
            th {
                padding: 6px 8px;
            }
            .day-cell {
                min-width: 30px;
                font-size: 0.75rem;
            }
            .watermark {
                font-size: 4rem;
                bottom: -10px;
                right: -20px;
            }
        }

        @media (max-width: 480px) {
            .cards-grid {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }
            .employees-grid {
                grid-template-columns: 1fr;
            }
            .topbar-actions button,
            .topbar-actions .btn {
                font-size: 0.7rem;
                padding: 5px 12px;
            }
            .modal .btn-row button {
                min-width: 60px;
                font-size: 0.8rem;
            }
        }

        /* ---------- ANIMACIONES ---------- */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.98);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(40px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ---------- UTILITY ---------- */
        .mt-8 {
            margin-top: 8px;
        }
        .mt-16 {
            margin-top: 16px;
        }
        .mb-8 {
            margin-bottom: 8px;
        }
        .mb-16 {
            margin-bottom: 16px;
        }
