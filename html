        // ================================================================
        // 11. TEMA
        // ================================================================

        function applyTheme() {
            const isDark = STATE.config.theme !== 'light';
            document.documentElement.classList.toggle('light-mode', !isDark);
            document.getElementById('themeToggle').textContent = isDark ? '🌙' : '☀️';
            // Actualizar gráficos
            setTimeout(() => {
                renderDashCharts();
                renderStats();
            }, 100);
        }

        function toggleTheme() {
            STATE.config.theme = STATE.config.theme === 'dark' ? 'light' : 'dark';
            saveState();
            applyTheme();
            renderAll();
        }

        // ================================================================
        // 12. NAVEGACIÓN
        // ================================================================

        function navigateTo(section) {
            document.querySelectorAll('.section').forEach(el => el.classList.remove('active'));
            document.getElementById(`section-${section}`).classList.add('active');
            document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
            document.querySelector(`.nav-btn[data-section="${section}"]`)?.classList.add('active');

            const titles = {
                dashboard: '📊 Dashboard',
                employees: '👥 Empleados',
                week: '📅 Semana actual',
                payments: '💵 Pagos',
                stats: '📊 Estadísticas',
                history: '📚 Historial',
                config: '⚙️ Configuración'
            };
            document.getElementById('pageTitle').innerHTML = `${titles[section] || 'Dashboard'} <small>${section === 'dashboard' ? 'Resumen general' : ''}</small>`;

            if (section === 'dashboard') renderDashboard();
            if (section === 'employees') renderEmployees();
            if (section === 'week') renderWeek();
            if (section === 'payments') renderPayments();
            if (section === 'stats') renderStats();
            if (section === 'history') renderHistory();
        }

