        // ================================================================
        // 7.  ACCIONES
        // ================================================================

        function toggleEmployeeStatus(id) {
            const emp = STATE.employees.find(e => e.id === id);
            if (!emp) return;
            emp.status = emp.status === 'active' ? 'inactive' : 'active';
            saveState();
            renderAll();
            showToast(`🔄 ${emp.name} ahora está ${emp.status === 'active' ? 'activo' : 'inactivo'}`, 'info');
        }

        function closeWeek() {
            const weekKey = STATE.currentWeekKey || getWeekKey();
            const active = STATE.employees.filter(e => e.status === 'active');
            if (active.length === 0) {
                showToast('⚠️ No hay empleados activos para cerrar la semana', 'error');
                return;
            }

            let totalPay = 0,
                totalPaid = 0,
                totalPending = 0;
            const details = active.map(emp => {
                const total = calculateWeekTotal(emp.id, weekKey);
                const paid = getEmployeePaid(emp.id);
                const pending = total - paid;
                totalPay += total;
                totalPaid += paid;
                totalPending += pending;
                return { name: emp.name, total, paid, pending };
            });

            let detailHtml = details.map(d =>
                `<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--border);">
                    <span>${d.name}</span>
                    <span>Ganó: $${d.total.toFixed(2)} | Pagado: $${d.paid.toFixed(2)} | Pendiente: $${d.pending.toFixed(2)}</span>
                </div>`
            ).join('');

            const html = `
                <div style="margin-bottom:12px;">
                    <strong>📅 ${getWeekLabel(weekKey)}</strong>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:0.9rem;">
                    <div>👥 Empleados: ${active.length}</div>
                    <div>💰 Total salarios: $${totalPay.toFixed(2)}</div>
                    <div>💵 Total pagado: $${totalPaid.toFixed(2)}</div>
                    <div>🔴 Total pendiente: $${totalPending.toFixed(2)}</div>
                </div>
                <hr style="border-color:var(--border);margin:12px 0;" />
                <div style="max-height:200px;overflow-y:auto;font-size:0.85rem;">${detailHtml}</div>
                <div class="btn-row">
                    <button class="btn-primary-modal" id="confirmCloseBtn">🔒 Confirmar cierre</button>
                    <button class="btn-secondary-modal" id="cancelCloseBtn">Cancelar</button>
                </div>
            `;

            openModal('🔒 Cerrar semana', html);

            document.getElementById('confirmCloseBtn').addEventListener('click', () => {
                // Guardar en historial
                STATE.history.push({
                    weekKey,
                    data: {
                        employees: active.length,
                        totalPay,
                        totalPaid,
                        pending: totalPending,
                        details: details,
                    },
                    timestamp: Date.now()
                });
                // Resetear pagos de esta semana? No, dejamos que el usuario maneje.
                saveState();
                closeModal();
                renderAll();
                showToast('✅ Semana cerrada correctamente', 'success');
            });

            document.getElementById('cancelCloseBtn').addEventListener('click', closeModal);
        }

        function copyPreviousWeek() {
            const currentWeek = STATE.currentWeekKey || getWeekKey();
            const d = new Date(currentWeek);
            d.setDate(d.getDate() - 7);
            const prevWeek = getWeekKey(d);

            if (!STATE.weeks[prevWeek]) {
                showToast('⚠️ No hay semana anterior para copiar', 'error');
                return;
            }

            const active = STATE.employees.filter(e => e.status === 'active');
            let copied = 0;
            active.forEach(emp => {
                const prevData = STATE.weeks[prevWeek]?.[emp.id];
                if (prevData) {
                    const currentData = getEmployeeWeekData(emp.id, currentWeek);
                    Object.keys(prevData).forEach(dk => {
                        currentData[dk] = { ...prevData[dk] };
                    });
                    copied++;
                }
            });

            if (copied === 0) {
                showToast('⚠️ No se pudo copiar ninguna jornada', 'error');
                return;
            }

            saveState();
            renderAll();
            showToast(`📋 Copiadas ${copied} semanas anteriores`, 'success');
        }

        function markAllComplete() {
            const weekKey = STATE.currentWeekKey || getWeekKey();
            const active = STATE.employees.filter(e => e.status === 'active');
            let count = 0;
            active.forEach(emp => {
                const data = getEmployeeWeekData(emp.id, weekKey);
                const days = getWeekDays(weekKey);
                days.forEach(d => {
                    const dk = getDayKey(d);
                    const dayOfWeek = d.getDay();
                    // No marcar domingo si no está habilitado
                    if (dayOfWeek === 0 && !STATE.config.includeSunday) return;
                    data[dk] = { type: 'complete', hours: 0, amount: emp.payDay || 0 };
                });
                count++;
            });
            saveState();
            renderAll();
            showToast(`✅ ${count} empleados marcados como día completo`, 'success');
        }

        // ================================================================
        // 8.  TOAST
        // ================================================================

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            toast.innerHTML = `<span class="toast-icon">${icons[type] || 'ℹ️'}</span> ${message}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(40px)';
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }

        // ================================================================
        // 9.  EXPORT / IMPORT
        // ================================================================

        function exportJSON() {
            const data = {
                employees: STATE.employees,
                weeks: STATE.weeks,
                payments: STATE.payments,
                history: STATE.history,
                config: STATE.config,
                exportedAt: new Date().toISOString()
            };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `respaldo_ivan_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('💾 Respaldo exportado', 'success');
        }

        function importJSON(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (!data.employees || !data.weeks) {
                        showToast('⚠️ Archivo inválido', 'error');
                        return;
                    }
                    if (!confirm('¿Reemplazar todos los datos actuales con el respaldo?')) return;
                    STATE.employees = data.employees;
                    STATE.weeks = data.weeks;
                    STATE.payments = data.payments || [];
                    STATE.history = data.history || [];
                    if (data.config) STATE.config = { ...STATE.config, ...data.config };
                    saveState();
                    renderAll();
                    showToast('📥 Respaldo importado correctamente', 'success');
                } catch (err) {
                    showToast('⚠️ Error al leer el archivo', 'error');
                }
            };
            reader.readAsText(file);
        }

