        // 5.6 Estadísticas
        function renderStats() {
            const filter = STATE.statsFilter;
            const weekKey = STATE.currentWeekKey || getWeekKey();
            let weeks = [];
            let count = filter === 'week' ? 1 : filter === 'month' ? 4 : filter === 'quarter' ? 12 : 52;

            const d = new Date(weekKey);
            for (let i = count - 1; i >= 0; i--) {
                const wk = getWeekKey(new Date(d.getTime() - i * 7 * 24 * 60 * 60 * 1000));
                weeks.push(wk);
            }

            const active = STATE.employees.filter(e => e.status === 'active');
            const weekLabels = weeks.map(w => getWeekLabel(w));

            // Chart 1: Gastos por semana
            const totals = weeks.map(w => {
                let sum = 0;
                active.forEach(emp => sum += calculateWeekTotal(emp.id, w));
                return sum;
            });
            renderChart('statsChart1', weekLabels, totals, 'Gastos');

            // Chart 2: Top empleados
            const top = [...active].sort((a, b) => {
                let sumA = 0,
                    sumB = 0;
                weeks.forEach(w => { sumA += calculateWeekTotal(a.id, w);
                    sumB += calculateWeekTotal(b.id, w); });
                return sumB - sumA;
            }).slice(0, 6);
            const topNames = top.map(e => e.name);
            const topAmounts = top.map(e => {
                let sum = 0;
                weeks.forEach(w => sum += calculateWeekTotal(e.id, w));
                return sum;
            });
            renderChart('statsChart2', topNames, topAmounts, 'Costo total', true);

            // Chart 3: Horas trabajadas
            const hoursData = weeks.map(w => {
                let sum = 0;
                active.forEach(emp => {
                    const data = getEmployeeWeekData(emp.id, w);
                    const days = getWeekDays(w);
                    days.forEach(d => {
                        const dk = getDayKey(d);
                        if (data[dk]) sum += data[dk].hours || 0;
                    });
                });
                return sum;
            });
            renderChart('statsChart3', weekLabels, hoursData, 'Horas');

            // Chart 4: Pagado vs Pendiente (semana actual)
            let paidTotal = 0,
                pendingTotal = 0;
            active.forEach(emp => {
                const total = calculateWeekTotal(emp.id, weekKey);
                const paid = getEmployeePaid(emp.id);
                paidTotal += paid;
                pendingTotal += (total - paid);
            });
            const ctx4 = document.getElementById('statsChart4').getContext('2d');
            if (STATE.charts['statsChart4']) STATE.charts['statsChart4'].destroy();
            const isDark4 = document.documentElement.classList.contains('light-mode') ? false : true;
            const color4 = isDark4 ? '#e8e8f0' : '#1a1a2e';
            STATE.charts['statsChart4'] = new Chart(ctx4, {
                type: 'doughnut',
                data: {
                    labels: ['Pagado', 'Pendiente'],
                    datasets: [{
                        data: [Math.max(0, paidTotal), Math.max(0, pendingTotal)],
                        backgroundColor: ['#2ecc71', '#e74c3c'],
                        borderColor: isDark4 ? '#0a0a0f' : '#f0f2f8',
                        borderWidth: 2,
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { labels: { color: color4, font: { size: 11 } } }
                    }
                }
            });

            // Chart 5: Evolución mensual (suma por mes)
            const monthMap = {};
            weeks.forEach(w => {
                const { start } = getWeekRange(w);
                const key = start.toISOString().slice(0, 7);
                if (!monthMap[key]) monthMap[key] = 0;
                let sum = 0;
                active.forEach(emp => sum += calculateWeekTotal(emp.id, w));
                monthMap[key] += sum;
            });
            const monthLabels = Object.keys(monthMap);
            const monthData = Object.values(monthMap);
            renderChart('statsChart5', monthLabels, monthData, 'Gasto mensual');
        }

        // ================================================================
        // 6.  MODALES
        // ================================================================

        function openModal(title, bodyHTML) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalBody').innerHTML = bodyHTML;
            document.getElementById('modalOverlay').classList.add('open');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('open');
        }

        // Día modal
        function openDayModal(employeeId, dayKey) {
            const emp = STATE.employees.find(e => e.id === employeeId);
            if (!emp) return;
            const weekKey = STATE.currentWeekKey || getWeekKey();
            const data = getEmployeeWeekData(employeeId, weekKey);
            const entry = data[dayKey] || { type: 'off', hours: 0, amount: 0 };

            const dayName = new Date(dayKey + 'T00:00:00').toLocaleDateString('es', { weekday: 'long', day: 'numeric',
                month: 'short' });

            const html = `
                <div style="margin-bottom:12px;"><strong>${emp.name}</strong> — ${dayName}</div>
                <label>Tipo de jornada</label>
                <select id="dayTypeSelect" style="width:100%;padding:8px 12px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg2);color:var(--text);">
                    <option value="off" ${entry.type === 'off' ? 'selected' : ''}>❌ No trabajó</option>
                    <option value="complete" ${entry.type === 'complete' ? 'selected' : ''}>🟢 Día completo</option>
                    <option value="half" ${entry.type === 'half' ? 'selected' : ''}>🟡 Media jornada</option>
                    <option value="hours" ${entry.type === 'hours' ? 'selected' : ''}>🔵 Por horas</option>
                </select>
                <div id="hoursContainer" style="${entry.type === 'hours' ? 'display:block;' : 'display:none;'}margin-top:10px;">
                    <label>Horas trabajadas</label>
                    <input type="number" id="dayHoursInput" value="${entry.hours || 0}" step="0.5" min="0" max="24" style="width:100%;padding:8px 12px;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg2);color:var(--text);" />
                    <div style="font-size:0.8rem;color:var(--text2);margin-top:4px;">Pago por hora: ${STATE.config.currency}${emp.payHour || 0}</div>
                </div>
                <div style="margin-top:12px;font-size:0.9rem;color:var(--text2);">
                    Total del día: <strong id="dayTotalPreview">${STATE.config.currency}${(entry.amount || 0).toFixed(2)}</strong>
                </div>
                <div class="btn-row">
                    <button class="btn-primary-modal" id="saveDayBtn">💾 Guardar</button>
                    <button class="btn-secondary-modal" id="cancelDayBtn">Cancelar</button>
                </div>
            `;

            openModal(`📅 Registrar jornada — ${emp.name}`, html);

            document.getElementById('dayTypeSelect').addEventListener('change', function() {
                const show = this.value === 'hours';
                document.getElementById('hoursContainer').style.display = show ? 'block' : 'none';
                updateDayPreview();
            });

            document.getElementById('dayHoursInput').addEventListener('input', updateDayPreview);

            function updateDayPreview() {
                const type = document.getElementById('dayTypeSelect').value;
                const hours = parseFloat(document.getElementById('dayHoursInput').value) || 0;
                let amount = 0;
                if (type === 'complete') amount = emp.payDay || 0;
                else if (type === 'half') amount = (emp.payDay || 0) / 2;
                else if (type === 'hours') amount = (emp.payHour || 0) * hours;
                document.getElementById('dayTotalPreview').textContent = `${STATE.config.currency}${amount.toFixed(2)}`;
            }

            document.getElementById('saveDayBtn').addEventListener('click', () => {
                const type = document.getElementById('dayTypeSelect').value;
                let hours = 0;
                if (type === 'hours') {
                    hours = parseFloat(document.getElementById('dayHoursInput').value) || 0;
                }
                const amount = calculateDayAmount(emp, type, hours);
                const data = getEmployeeWeekData(employeeId, weekKey);
                data[dayKey] = { type, hours, amount };
                saveState();
                closeModal();
                renderAll();
                showToast('✅ Jornada registrada correctamente', 'success');
            });

            document.getElementById('cancelDayBtn').addEventListener('click', closeModal);
        }

        // Ver empleado
        function viewEmployee(employeeId) {
            const emp = STATE.employees.find(e => e.id === employeeId);
            if (!emp) return;
            const weekKey = STATE.currentWeekKey || getWeekKey();
            const data = getEmployeeWeekData(employeeId, weekKey);
            const days = getWeekDays(weekKey);
            const total = calculateWeekTotal(employeeId, weekKey);
            const paid = getEmployeePaid(employeeId);
            const pending = total - paid;

            let dayList = days.map(d => {
                const dk = getDayKey(d);
                const entry = data[dk] || { type: 'off', hours: 0, amount: 0 };
                const label = entry.type === 'complete' ? '🟢 Completo' :
                    entry.type === 'half' ? '🟡 Medio' :
                    entry.type === 'hours' ? `🔵 ${entry.hours}h` :
                    '❌ No trabajó';
                return `<div class="day-item"><span>${d.toLocaleDateString('es', { weekday:'short', day:'numeric' })}</span><span>${label} — ${STATE.config.currency}${entry.amount.toFixed(2)}</span></div>`;
            }).join('');

            const html = `
                <div class="profile-header">
                    <div class="big-avatar">${emp.avatar || '👤'}</div>
                    <div>
                        <h3 style="margin:0;">${emp.name}</h3>
                        <div style="color:var(--text2);">${emp.role || 'Sin cargo'} ${emp.phone ? '📞 '+emp.phone : ''}</div>
                        <span class="status ${emp.status}">${emp.status === 'active' ? '🟢 Activo' : '🔴 Inactivo'}</span>
                    </div>
                </div>
                <div class="profile-detail">
                    <span><strong>💰 Día completo:</strong> ${STATE.config.currency}${(emp.payDay || 0).toFixed(2)}</span>
                    <span><strong>🟡 Media:</strong> ${STATE.config.currency}${((emp.payDay || 0)/2).toFixed(2)}</span>
                    <span><strong>⏱️ Hora:</strong> ${STATE.config.currency}${(emp.payHour || 0).toFixed(2)}</span>
                </div>
                <hr style="border-color:var(--border);margin:12px 0;" />
                <div><strong>📅 Semana actual</strong></div>
                <div class="day-detail-list">${dayList}</div>
