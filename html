                STATE.config.includeSunday = document.getElementById('configSunday').checked;
                STATE.config.pin = document.getElementById('configPin').value || '';
                saveState();
                renderAll();
                showToast('⚙️ Configuración guardada', 'success');
            });

            // Cargar config en formulario
            document.getElementById('configBusinessName').value = STATE.config.businessName || '';
            document.getElementById('configAdminName').value = STATE.config.adminName || '';
            document.getElementById('configCurrency').value = STATE.config.currency || '$';
            document.getElementById('configWeekStart').value = STATE.config.weekStart || 'Lunes';
            document.getElementById('configWeekEnd').value = STATE.config.weekEnd || 'Sábado';
            document.getElementById('configSunday').checked = STATE.config.includeSunday || false;
            document.getElementById('configPin').value = STATE.config.pin || '';

            // Exportar PDF/Excel/CSV (simplificado)
            document.getElementById('exportPDF').addEventListener('click', () => {
                showToast('📄 Exportando PDF... (demo)', 'info');
                // Aquí se podría integrar una librería como jsPDF
            });
            document.getElementById('exportExcel').addEventListener('click', () => {
                showToast('📊 Exportando Excel... (demo)', 'info');
            });
            document.getElementById('exportCSV').addEventListener('click', () => {
                showToast('📋 Exportando CSV... (demo)', 'info');
            });

            // Instalación PWA
            let deferredPrompt;
            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                document.getElementById('installBtn').style.display = 'inline-block';
            });
            document.getElementById('installBtn').addEventListener('click', async () => {
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const result = await deferredPrompt.userChoice;
                    if (result.outcome === 'accepted') {
                        showToast('📲 App instalada correctamente', 'success');
                    }
                    deferredPrompt = null;
                    document.getElementById('installBtn').style.display = 'none';
                }
            });

            // Teclado: ESC para cerrar modal
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });

            // Guardar estado al cerrar
            window.addEventListener('beforeunload', saveState);

            console.log('💰 IVAN MARÍNEZ — Control Financiero de Empleados');
            console.log('✅ Sistema listo');
        }

        // ================================================================
        // 14. ARRANQUE
        // ================================================================
        document.addEventListener('DOMContentLoaded', init);
    </script>

</body>
</html>
