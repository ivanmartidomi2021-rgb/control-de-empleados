                        </div>
                        <div class="totals">
                            <span>💰 <strong>${STATE.config.currency}${total.toFixed(2)}</strong></span>
                            <span>💵 Pagado: <strong>${STATE.config.currency}${paid.toFixed(2)}</strong></span>
                            <span>🔴 Pendiente: <strong>${STATE.config.currency}${pending.toFixed(2)}</strong></span>
                            <button class="history-detail" data-week="${h.weekKey}" style="background:var(--bg3);border:none;color:var(--text);padding:4px 14px;border-radius:20px;cursor:pointer;">Ver detalles</button>
