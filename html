    <script>
        // ================================================================
        // 1.  ESTADO GLOBAL
        // ================================================================
        const STATE = {
            employees: [],
            weeks: {}, // key: "YYYY-MM-DD" (lunes) -> { employeeId: { mon:{...}, tue:{...}, ... } }
            payments: [], // { employeeId, amount, date, concept, note, weekKey }
            history: [], // { weekKey, data: {...} }
            config: {
                businessName: 'Mi Negocio',
                adminName: 'Administrador',
                currency: '$',
                weekStart: 'Lunes',
                weekEnd: 'Sábado',
                includeSunday: false,
                pin: '',
                theme: 'dark'
            },
            currentWeekKey: null,
            currentEmployeeId: null,
            charts: {},
            filter: 'all',
            statsFilter: 'week',
            searchQuery: '',
        };

        // Días de la semana (0 = domingo)
        const DAYS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
        const DAYS_SHORT = ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá'];
        const DAYS_INDEX = { lun: 1, mar: 2, mié: 3, jue: 4, vie: 5, sáb: 6, dom: 0 };

        // ================================================================
        // 2.  PERSISTENCIA (IndexedDB / LocalStorage)
        // ================================================================
        function saveState() {
            try {
                const data = {
                    employees: STATE.employees,
                    weeks: STATE.weeks,
                    payments: STATE.payments,
                    history: STATE.history,
                    config: STATE.config,
                };
                localStorage.setItem('ivan_control_data', JSON.stringify(data));
            } catch (e) { console.warn('Save error', e); }
        }

        function loadState() {
            try {
                const raw = localStorage.getItem('ivan_control_data');
                if (raw) {
                    const data = JSON.parse(raw);
                    STATE.employees = data.employees || [];
                    STATE.weeks = data.weeks || {};
                    STATE.payments = data.payments || [];
                    STATE.history = data.history || [];
                    STATE.config = { ...STATE.config, ...(data.config || {}) };
                }
            } catch (e) { console.warn('Load error', e); }
        }

        // ================================================================
        // 3.  EMPLEADOS INICIALES
        // ================================================================
        const DEFAULT_EMPLOYEES = [
            { id: 'emp1', name: 'Darwin', role: 'Trabajador', phone: '', status: 'active', payDay: 35, payHalf: 17.5,
                payHour: 5, notes: '', avatar: 'D' },
            { id: 'emp2', name: 'Cristofer', role: 'Trabajador', phone: '', status: 'active', payDay: 30, payHalf: 15,
                payHour: 4, notes: '', avatar: 'C' },
            { id: 'emp3', name: 'Ivan', role: 'Administrador', phone: '', status: 'active', payDay: 40, payHalf: 20,
                payHour: 5, notes: '', avatar: 'I' },
            { id: 'emp4', name: 'Oseas', role: 'Trabajador', phone: '', status: 'active', payDay: 32, payHalf: 16,
                payHour: 4.5, notes: '', avatar: 'O' },
            { id: 'emp5', name: 'Erick', role: 'Trabajador', phone: '', status: 'active', payDay: 30, payHalf: 15,
                payHour: 4, notes: '', avatar: 'E' },
            { id: 'emp6', name: 'Dima', role: 'Trabajador', phone: '', status: 'active', payDay: 28, payHalf: 14,
                payHour: 3.5, notes: '', avatar: 'D' },
        ];

        function initEmployees() {
            if (STATE.employees.length === 0) {
                STATE.employees = DEFAULT_EMPLOYEES.map(e => ({ ...e, id: e.id || 'emp_' + Date.now() + '_' + Math.random()
                        .toString(36).slice(2, 6) }));
                saveState();
            }
        }

        // ================================================================
        // 4.  FUNCIONES DE SEMANA
        // ================================================================
        function getWeekKey(date = new Date()) {
            const d = new Date(date);
            const day = d.getDay();
            const diff = d.getDate() - day + (day === 0 ? -6 : 1); // Lunes
            const monday = new Date(d.setDate(diff));
            monday.setHours(0, 0, 0, 0);
            return monday.toISOString().split('T')[0];
        }

        function getWeekRange(weekKey) {
            const start = new Date(weekKey + 'T00:00:00');
            const end = new Date(start);
            end.setDate(start.getDate() + 6);
            return { start, end };
        }

        function getWeekLabel(weekKey) {
            const { start, end } = getWeekRange(weekKey);
            const opts = { day: 'numeric', month: 'short' };
            return `${start.toLocaleDateString('es', opts)} → ${end.toLocaleDateString('es', opts)}`;
        }

        function getWeekDays(weekKey) {
            const { start } = getWeekRange(weekKey);
            const days = [];
            for (let i = 0; i < 7; i++) {
                const d = new Date(start);
                d.setDate(start.getDate() + i);
                days.push(d);
            }
            return days;
        }

        function getDayKey(date) {
            return date.toISOString().split('T')[0];
        }

        function getEmployeeWeekData(employeeId, weekKey) {
            if (!STATE.weeks[weekKey]) STATE.weeks[weekKey] = {};
            if (!STATE.weeks[weekKey][employeeId]) {
                STATE.weeks[weekKey][employeeId] = {};
                const days = getWeekDays(weekKey);
                days.forEach(d => {
                    const dk = getDayKey(d);
                    STATE.weeks[weekKey][employeeId][dk] = { type: 'off', hours: 0, amount: 0 };
                });
            }
            return STATE.weeks[weekKey][employeeId];
        }

        function calculateDayAmount(employee, type, hours = 0) {
            if (type === 'complete') return employee.payDay || 0;
            if (type === 'half') return (employee.payDay || 0) / 2;
            if (type === 'hours') return (employee.payHour || 0) * hours;
            return 0;
        }

        function calculateWeekTotal(employeeId, weekKey) {
            const emp = STATE.employees.find(e => e.id === employeeId);
            if (!emp) return 0;
            const data = getEmployeeWeekData(employeeId, weekKey);
            let total = 0;
            const days = getWeekDays(weekKey);
            days.forEach(d => {
                const dk = getDayKey(d);
                if (data[dk]) {
                    total += data[dk].amount || 0;
                }
            });
            return total;
        }

        function getEmployeePayments(employeeId) {
            return STATE.payments.filter(p => p.employeeId === employeeId);
        }

        function getEmployeePaid(employeeId) {
            return getEmployeePayments(employeeId).reduce((sum, p) => sum + p.amount, 0);
        }

        function getEmployeePending(employeeId, weekKey) {
            const earned = calculateWeekTotal(employeeId, weekKey);
            const paid = getEmployeePaid(employeeId);
            // También considerar pagos de semanas anteriores en el historial
            // Para simplificar, usamos solo la semana actual
            return earned - paid;
        }

        // ================================================================
        // 5.  RENDERIZADO
        // ================================================================

        // 5.1 Dashboard
        function renderDashboard() {
            const active = STATE.employees.filter(e => e.status === 'active');
            let totalPay = 0,
                totalPaid = 0,
                totalDays = 0,
                totalHours = 0;

            const weekKey = STATE.currentWeekKey || getWeekKey();
            STATE.currentWeekKey = weekKey;

            active.forEach(emp => {
                const data = getEmployeeWeekData(emp.id, weekKey);
                const days = getWeekDays(weekKey);
                days.forEach(d => {
                    const dk = getDayKey(d);
                    if (data[dk] && data[dk].type !== 'off') {
                        totalDays++;
                        totalHours += data[dk].hours || 0;
                    }
                });
                const total = calculateWeekTotal(emp.id, weekKey);
                totalPay += total;
                const paid = getEmployeePaid(emp.id);
                totalPaid += paid;
            });

            const pending = totalPay - totalPaid;
            const avg = active.length ? totalPay / active.length : 0;

            document.getElementById('dashTotalPay').textContent = `$${totalPay.toFixed(2)}`;
            document.getElementById('dashActive').textContent = active.length;
            document.getElementById('dashDays').textContent = totalDays;
            document.getElementById('dashHours').textContent = totalHours.toFixed(1);
            document.getElementById('dashPaid').textContent = `$${totalPaid.toFixed(2)}`;
            document.getElementById('dashPending').textContent = `$${pending.toFixed(2)}`;
            document.getElementById('dashAvg').textContent = `$${avg.toFixed(2)}`;

            // Mensajes
            const msgs = [];
            if (active.length > 0) msgs.push(`👥 Tienes ${active.length} empleados activos.`);
            if (totalPay > 0) msgs.push(`💰 Debes pagar $${totalPay.toFixed(2)} esta semana.`);
            if (pending > 0) msgs.push(`🔴 Hay $${pending.toFixed(2)} pendientes de pago.`);
            if (totalDays > 0) msgs.push(`📅 Se han trabajado ${totalDays} días en total.`);
            const topEmp = active.sort((a, b) => calculateWeekTotal(b.id, weekKey) - calculateWeekTotal(a.id, weekKey))[0];
            if (topEmp && calculateWeekTotal(topEmp.id, weekKey) > 0) {
                msgs.push(`🏆 ${topEmp.name} ha generado $${calculateWeekTotal(topEmp.id, weekKey).toFixed(2)}.`);
            }
            if (msgs.length === 0) msgs.push('📌 No hay datos esta semana. Comienza registrando jornadas.');
            document.getElementById('dashMessages').innerHTML = msgs.map(m => `• ${m}`).join('<br />');
            document.getElementById('dashMessageTime').textContent = `Actualizado: ${new Date().toLocaleTimeString()}`;

            // Gráficos rápidos
            renderDashCharts();
        }

        function renderDashCharts() {
            const weekKey = STATE.currentWeekKey || getWeekKey();
            const active = STATE.employees.filter(e => e.status === 'active');

            // Chart 1: Gastos por semana (últimas 6 semanas)
            const weeks = [];
            const totals = [];
            const d = new Date(weekKey);
            for (let i = 5; i >= 0; i--) {
                const wk = getWeekKey(new Date(d.getTime() - i * 7 * 24 * 60 * 60 * 1000));
                weeks.push(getWeekLabel(wk));
                let sum = 0;
                active.forEach(emp => {
                    sum += calculateWeekTotal(emp.id, wk);
                });
                totals.push(sum);
            }
            renderChart('dashChart1', weeks, totals, 'Gastos');

            // Chart 2: Top empleados
            const names = [];
            const amounts = [];
            const sorted = [...active].sort((a, b) => calculateWeekTotal(b.id, weekKey) - calculateWeekTotal(a.id, weekKey))
                .slice(0, 6);
            sorted.forEach(emp => {
                names.push(emp.name);
                amounts.push(calculateWeekTotal(emp.id, weekKey));
            });
            renderChart('dashChart2', names, amounts, 'Costo', true);
        }

        function renderChart(id, labels, data, label, horizontal = false) {
            const canvas = document.getElementById(id);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (STATE.charts[id]) STATE.charts[id].destroy();

            const isDark = document.documentElement.classList.contains('light-mode') ? false : true;
            const color = isDark ? '#e8e8f0' : '#1a1a2e';
            const bgColor = isDark ? 'rgba(79,140,255,0.2)' : 'rgba(79,140,255,0.15)';

            STATE.charts[id] = new Chart(ctx, {
                type: horizontal ? 'bar' : 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: label,
                        data: data,
                        backgroundColor: bgColor,
                        borderColor: '#4f8cff',
                        borderWidth: 2,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { labels: { color: color, font: { size: 10 } } }
                    },
                    scales: {
                        x: { ticks: { color: color, font: { size: 9 } }, grid: { color: isDark ? 'rgba(255,255,255,0.05)' :
                                    'rgba(0,0,0,0.05)' } },
                        y: { ticks: { color: color, font: { size: 9 } }, grid: { color: isDark ? 'rgba(255,255,255,0.05)' :
                                    'rgba(0,0,0,0.05)' } }
                    }
                }
            });
        }

        // 5.2 Empleados
        function renderEmployees() {
            const grid = document.getElementById('employeesGrid');
            const query = STATE.searchQuery.toLowerCase();
            let list = STATE.employees;

            if (STATE.filter === 'active') list = list.filter(e => e.status === 'active');
            else if (STATE.filter === 'inactive') list = list.filter(e => e.status === 'inactive');
            else if (STATE.filter === 'debt') {
                const wk = STATE.currentWeekKey || getWeekKey();
                list = list.filter(e => getEmployeePending(e.id, wk) > 0);
            }

            if (query) {
                list = list.filter(e =>
                    e.name.toLowerCase().includes(query) ||
                    (e.role && e.role.toLowerCase().includes(query)) ||
                    (e.phone && e.phone.includes(query))
                );
            }

            if (list.length === 0) {
                grid.innerHTML =
                    `<div class="card" style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text3);">👀 No hay empleados que coincidan</div>`;
                return;
            }

            grid.innerHTML = list.map(emp => {
                const wk = STATE.currentWeekKey || getWeekKey();
                const pending = getEmployeePending(emp.id, wk);
                const paid = getEmployeePaid(emp.id);
                const total = calculateWeekTotal(emp.id, wk);
                return `
                    <div class="employee-card" data-id="${emp.id}">
                        <div class="name">${emp.avatar || '👤'} ${emp.name}</div>
                        <div class="role">${emp.role || 'Sin cargo'} ${emp.phone ? '📞 '+emp.phone : ''}</div>
                        <span class="status ${emp.status}">${emp.status === 'active' ? '🟢 Activo' : '🔴 Inactivo'}</span>
                        <div style="font-size:0.8rem;color:var(--text2);margin-top:4px;">
                            Semana: $${total.toFixed(2)} | Pagado: $${paid.toFixed(2)}
                        </div>
                        ${pending > 0 ? `<div class="debt">🔴 Pendiente: $${pending.toFixed(2)}</div>` : ''}
                        <div style="margin-top:6px;display:flex;gap:4px;flex-wrap:wrap;">
                            <button class="emp-action" data-action="view" data-id="${emp.id}" style="background:var(--bg3);border:none;color:var(--text);padding:2px 10px;border-radius:20px;font-size:0.7rem;cursor:pointer;">👁️ Ver</button>
                            <button class="emp-action" data-action="edit" data-id="${emp.id}" style="background:var(--bg3);border:none;color:var(--text);padding:2px 10px;border-radius:20px;font-size:0.7rem;cursor:pointer;">✏️ Editar</button>
                            <button class="emp-action" data-action="pay" data-id="${emp.id}" style="background:var(--bg3);border:none;color:var(--text);padding:2px 10px;border-radius:20px;font-size:0.7rem;cursor:pointer;">💵 Pago</button>
                            <button class="emp-action" data-action="toggle" data-id="${emp.id}" style="background:var(--bg3);border:none;color:var(--text);padding:2px 10px;border-radius:20px;font-size:0.7rem;cursor:pointer;">${emp.status === 'active' ? '⏸️' : '▶️'}</button>
                        </div>
                    </div>
                `;
            }).join('');

            // Eventos
            document.querySelectorAll('.emp-action').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const action = btn.dataset.action;
                    const id = btn.dataset.id;
                    if (action === 'view') viewEmployee(id);
                    else if (action === 'edit') editEmployee(id);
                    else if (action === 'pay') openPaymentModal(id);
                    else if (action === 'toggle') toggleEmployeeStatus(id);
                });
            });

            document.querySelectorAll('.employee-card').forEach(card => {
                card.addEventListener('click', () => {
                    const id = card.dataset.id;
                    viewEmployee(id);
                });
            });
        }

        // 5.3 Tabla Semanal
        function renderWeek() {
            const weekKey = STATE.currentWeekKey || getWeekKey();
            STATE.currentWeekKey = weekKey;
            document.getElementById('weekLabel').textContent = `📅 ${getWeekLabel(weekKey)}`;

            const tbody = document.getElementById('weekBody');
            const active = STATE.employees.filter(e => e.status === 'active');

            if (active.length === 0) {
                tbody.innerHTML =
                    `<tr><td colspan="8" style="text-align:center;padding:30px;color:var(--text3);">👥 No hay empleados activos. Agrega uno.</td></tr>`;
                return;
            }

            const days = getWeekDays(weekKey);
            const dayKeys = days.map(d => getDayKey(d));
            const dayNames = days.map(d => DAYS_SHORT[d.getDay()]);

            let html = '';
            active.forEach(emp => {
                const data = getEmployeeWeekData(emp.id, weekKey);
                let total = 0;
                let dayCells = dayKeys.map(dk => {
                    const entry = data[dk] || { type: 'off', hours: 0, amount: 0 };
                    total += entry.amount || 0;
                    const icon = entry.type === 'complete' ? '🟢' :
                        entry.type === 'half' ? '🟡' :
                        entry.type === 'hours' ? `🔵${entry.hours}h` :
                        '❌';
                    const cls = entry.type === 'complete' ? 'complete' :
                        entry.type === 'half' ? 'half' :
                        entry.type === 'hours' ? 'hours' : 'off';
                    return `<td><span class="day-cell ${cls}" data-emp="${emp.id}" data-day="${dk}">${icon}</span></td>`;
                });

                html += `
                    <tr>
                        <td class="employee-name" data-emp="${emp.id}">
                            <span class="avatar">${emp.avatar || '👤'}</span>
                            ${emp.name}
                        </td>
                        ${dayCells.join('')}
                        <td class="total-col">$${total.toFixed(2)}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;

            // Eventos de clic en celdas
            document.querySelectorAll('.day-cell').forEach(cell => {
                cell.addEventListener('click', () => {
                    const empId = cell.dataset.emp;
                    const dayKey = cell.dataset.day;
                    openDayModal(empId, dayKey);
                });
            });

            // Clic en nombre para ver perfil
            document.querySelectorAll('.employee-name').forEach(el => {
                el.addEventListener('click', () => {
                    const empId = el.dataset.emp;
                    if (empId) viewEmployee(empId);
                });
            });

            updatePaymentsSelect();
        }

        // 5.4 Pagos
        function renderPayments() {
            updatePaymentsSelect();
            renderPaymentHistory();
        }

        function updatePaymentsSelect() {
            const sel = document.getElementById('paymentEmployee');
            const current = sel.value;
            sel.innerHTML = STATE.employees.filter(e => e.status === 'active').map(e =>
                `<option value="${e.id}">${e.name}</option>`
            ).join('');
            if (current) sel.value = current;
            // Fecha por defecto
            document.getElementById('paymentDate').value = new Date().toISOString().split('T')[0];
        }

        function renderPaymentHistory() {
            const container = document.getElementById('paymentHistoryList');
            const wk = STATE.currentWeekKey || getWeekKey();
            const payments = STATE.payments.filter(p => p.weekKey === wk || !p.weekKey);
            if (payments.length === 0) {
                container.innerHTML = `<div class="text-muted" style="padding:12px;">No hay pagos registrados esta semana.</div>`;
                return;
            }
            container.innerHTML = payments.map(p => {
                const emp = STATE.employees.find(e => e.id === p.employeeId);
                return `
                    <div class="history-item">
                        <div><strong>${emp ? emp.name : 'Desconocido'}</strong> — ${p.concept || 'Pago'}</div>
                        <div class="totals">
                            <span>${p.date || ''}</span>
                            <strong>${STATE.config.currency}${p.amount.toFixed(2)}</strong>
                            ${p.note ? `<span class="text-muted">📝 ${p.note}</span>` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        // 5.5 Historial
        function renderHistory() {
            const container = document.getElementById('historyList');
            if (STATE.history.length === 0) {
                container.innerHTML = `<div class="text-muted" style="padding:20px;">No hay semanas cerradas aún.</div>`;
                return;
            }
            container.innerHTML = [...STATE.history].reverse().map(h => {
